# MYERP Frontend UI Development (Pre-configured for Staging API)
# No .env file is required to start: `npm run dev` automatically proxies
# `/backend` and `/uploads` to https://myerp-stagging.ideas.edu.vn.
#
# Copy to `.env.local` only if you want to override the Staging target.
VITE_PROXY_TARGET=https://myerp-stagging.ideas.edu.vn/backend
VITE_API_URL=/backend
